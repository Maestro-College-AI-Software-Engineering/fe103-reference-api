# Copy this file to .env and change the values. Never commit .env.

# Which config class create_app() uses when you run the flask command:
# development, testing or production. Docker and Render use production.
APP_CONFIG=development

# Database. Leave it empty in development to use a local SQLite file
# (instance/taskapi.db). docker compose sets its own Postgres URL.
# Postgres format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Secret that signs login tokens. Use a long random string, for example the output of:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string

# How long a login token stays valid, in minutes.
TOKEN_TTL_MINUTES=60

# Frontend origins allowed to call this API from a browser. Comma-separated,
# exact scheme + host + port, no trailing slash. Add your deployed frontend here.
CORS_ORIGINS=http://localhost:5173

# Docker image only (start.sh): 1 = create the demo users on startup, 0 = don't.
SEED_DEMO_DATA=1

# Docker image only: the port gunicorn listens on. Render sets this for you.
PORT=8000
